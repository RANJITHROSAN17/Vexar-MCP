{
  "name": "Contributor Enforcement — Corporate Standard",
  "target": "default",
  "enforcement": "active",
  "conditions": {
    "ref_name": {
      "include": ["~DEFAULT_BRANCH"],
      "exclude": []
    }
  },
  "rules": [
    {
      "type": "deletion",
      "parameters": {}
    },
    {
      "type": "required_linear_history",
      "parameters": {}
    },
    {
      "type": "pull_request",
      "parameters": {
        "dismiss_stale_reviews_on_push": true,
        "require_code_owner_review": true,
        "require_last_push_approval": false,
        "required_approving_review_count": 1,
        "required_review_thread_resolution": true,
        "bypass_actor_ids": [100000000]
      }
    },
    {
      "type": "required_status_checks",
      "parameters": {
        "required_status_checks": [
          {"context": "CI / Dogfood Composite Action", "integration_id": 15368},
          {"context": "CI / PR Governance & Auto-Labeler Bot", "integration_id": 15368},
          {"context": "CI / Roadmap & Issue Curator Bot", "integration_id": 15368},
          {"context": "CI / Test & Lint (Python 3.10)", "integration_id": 15368},
          {"context": "CI / Test & Lint (Python 3.11)", "integration_id": 15368},
          {"context": "CI / Test & Lint (Python 3.12)", "integration_id": 15368}
        ],
        "strict_required_status_checks_policy": true
      }
    },
    {
      "type": "non_fast_forward",
      "parameters": {}
    }
  ],
  "bypass_actors": [
    {
      "actor_id": 100000000,
      "actor_type": "OrganizationAdmin",
      "bypass_mode": "always"
    }
  ]
}
